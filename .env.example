# Copy this file to .env and fill in the keys you have.
# Every key below is optional - WeyWeGoing? degrades to a clearly-labeled
# demo/unavailable mode for any provider whose key is missing, instead of
# crashing. See README.md "Live mode vs demo mode" for details.

# Groq (LLM) - required for the natural-language agent (main.py / chat tab).
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# WeatherAPI.com - powers real near-term weather scoring.
# Free key: https://www.weatherapi.com/signup.aspx
WEATHER_API_KEY=

# Amadeus Self-Service (Flight Offers Search, TEST environment) - real
# sandbox flight quotes. Without these, flight prices fall back to a
# clearly-labeled demo estimate.
# Free account + test API key: https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Currency conversion (Frankfurter) needs no API key - always live.
